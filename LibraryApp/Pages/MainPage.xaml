<Page x:Class="LibraryApp.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LibraryApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0" Background="#131326" >
            <Label FontSize="15" FontWeight="Bold" Foreground="White" Margin="0 0 0 20">Читай, Пиши и не спиши</Label>
            <Button Width="100" Height="50" Margin="5" ToolTip="Каталог"></Button>
            <Button Width="100" Height="50" Margin="5" ToolTip="Списки Книг"></Button>
            <Button x:Name="Admin" Width="100" Height="50" Margin="5" ToolTip="Администрирование"></Button>
            <Button Width="100" Height="50" Margin="5" ToolTip="Страница Автора"></Button>
            <TextBlock Foreground="Yellow" TextAlignment="Center">!!! Аккаунт Заморожен !!!</TextBlock>
            <Button Width="100" Height="50" Margin="5" ToolTip="Профиль"></Button>
        </StackPanel>
        <Frame x:Name="MainFrame" Grid.Column="1" Source="CatalogPage.xaml" NavigationUIVisibility="Hidden"/>

        <Button Background="#131326" Grid.Column="1" Foreground="White" Width="100" Height="20" Margin="5" Click="Back_Click" HorizontalAlignment="Right" VerticalAlignment="Top">Вернуться</Button>
    </Grid>
</Page>
