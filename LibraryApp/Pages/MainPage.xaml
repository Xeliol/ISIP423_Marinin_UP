<Page x:Class="LibraryApp.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LibraryApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0" Background="#131326" >
            <Label FontSize="15" FontWeight="Bold" Foreground="White" Margin="0 0 0 20">Читай, Пиши и не спиши</Label>
            <Button Width="60" Height="60" Margin="5" ToolTip="Каталог" Click="CatalogButton_Click" Background="#131326">
                <Image Source="/Images/Icons/Catalog.png" VerticalAlignment="Center"/>
            </Button>
            <Button Width="60" Height="60" Margin="5" ToolTip="Списки Книг" Click="ListsButton_Click" Background="#131326">
                <Image Source="/Images/Icons/bookmark.png"/>
            </Button>
            <Button x:Name="Admin" Width="60" Height="60" Margin="5" ToolTip="Администрирование" Background="#131326" Click="Admin_Click" Visibility="Collapsed">
                <Image Source="/Images/Icons/admin.png"/>
            </Button>
            <Button x:Name="AuthorButton" Width="60" Height="60" Margin="5" ToolTip="Страница Автора" Background="#131326" Click="Author_Click" Visibility="Collapsed">
                <Image Source="/Images/Icons/author.png"/>
            </Button>
            <TextBlock Foreground="Yellow" TextAlignment="Center" Text="!!! Аккаунт Заморожен !!!">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Frozen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Width="60" Height="60" Margin="5" ToolTip="Профиль" Click="AccountButton_Click" Background="#131326">
                <Image Source="/Images/Icons/profile.png"/>
            </Button>
            <Button x:Name="LogOut_Button" Width="60" Margin="5" ToolTip="Профиль" Click="LogOutButton_Click" Background="#131326" Foreground="White">
                Выйти
            </Button>
        </StackPanel>
        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Page>
