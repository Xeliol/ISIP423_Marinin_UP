<Page x:Class="LibraryApp.Pages.BookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LibraryApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BookPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding ImagePath}" Width="200" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"/>
                <StackPanel>
                    <TextBlock FontSize="26" Text="{Binding Name}"/>
                    <TextBlock Text="{Binding Users.Name, StringFormat={}Автор: {0}}"/>
                    <TextBlock Text="{Binding Rating, StringFormat={}Рейтинг: {0}}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Жанры:"/>
                        <ListBox ItemsSource="{Binding BooksGenres}" Grid.Row="1" Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="FloralWhite">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Genres.Name}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </StackPanel>
                    <Button Background="#131326" Foreground="White" Width="100" Margin="5" Click="Button_Click">Читать</Button>
                </StackPanel>
            </StackPanel>
            <Button Background="Yellow" HorizontalAlignment="Left" Width="100" Margin="5">Жалоба на книгу</Button>
            <Button Background="Yellow" HorizontalAlignment="Left" Width="120" Margin="5">Жалоба на автора</Button>
            <Button Background="Cyan" HorizontalAlignment="Left" Width="120" Margin="5">Заморозить</Button>
            <TextBox Width="400" Height="75" HorizontalAlignment="Left" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.CanContentScroll="True"></TextBox>
            <Button Background="#131326" HorizontalAlignment="Left" Foreground="White" Width="100" Margin="5">Отправить</Button>
            <ListBox x:Name="ReviewsListbox" Grid.Row="1" Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="FloralWhite">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Genres.Name}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </StackPanel>
    </Grid>
</Page>
