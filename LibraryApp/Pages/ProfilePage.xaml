<Page x:Class="LibraryApp.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LibraryApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfilePage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0">
            <Image Source="{Binding ImagePath}" Margin="50 10"/>
            <TextBlock Text="{Binding Name}" FontSize="22"></TextBlock>
            <TextBlock Text="{Binding Roles.Name}"></TextBlock>
            <TextBlock Text="{Binding Login, StringFormat={}Логин: {0}}"></TextBlock>
            <TextBlock Text="{Binding Email, StringFormat={}Email: {0}}"></TextBlock>
            <Button Background="#131326" Foreground="White" Width="100" Margin="5" Click="LogOut_Click" >Выйти</Button>
        </StackPanel>
        <StackPanel Grid.Column="1" >
            <Label Content="Отзывы" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"></Label>
            <ListBox x:Name="ReviewsListbox" Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="FloralWhite">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Books.Name}" FontWeight="Bold"></TextBlock>
                            <TextBlock Text="{Binding Books.Users.Name}" FontSize="10"></TextBlock>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <Image Source="{Binding Users.ImagePath}" Width="50"/>
                                    <TextBlock Text="{Binding Users.Name}"></TextBlock>
                                    <TextBlock FontWeight="Bold" Text="{Binding Rating, StringFormat={}{0}/10}"></TextBlock>
                                </StackPanel>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"></TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="0 50">
            <TextBlock x:Name="Warning" Background="#131326" Foreground="Yellow" TextAlignment="Center" Text="!!! Аккаунт Заморожен !!!" FontSize="20"></TextBlock>
            <Button x:Name="RequestUnfreeze" Background="Blue" Foreground="White" Width="120" Margin="5" Click="RequestUnfreeze_Click" Content="Оспорить заморозку"></Button>
            <Button x:Name="RequestRole" Background="ForestGreen" Foreground="White" Width="160" Margin="5" Click="RequestRole_Click" Content="Запросить роль Автора"></Button>
        </StackPanel>
    </Grid>
</Page>
