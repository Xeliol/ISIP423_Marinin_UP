<Page x:Class="LibraryApp.Pages.BookListsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LibraryApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BookListsPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ListBox x:Name="ListsListBox" Grid.Row="1" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="White">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Label Content="{Binding ListTypes.Name}" FontSize="22" Margin="5" HorizontalAlignment="Center"></Label>
                        <ListBox ItemsSource="{Binding BooksLists}" Grid.Row="1" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="White">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image Source="{Binding Books.ImagePath}"/>
                                        <TextBlock FontSize="18" Text="{Binding Books.Name}"/>
                                        <TextBlock Text="{Binding Books.Users.Name, StringFormat={}Автор: {0}}"/>
                                        <TextBlock Text="{Binding Books.Rating, StringFormat={}Рейтинг: {0}}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Жанры:"/>
                                            <ListBox ItemsSource="{Binding Books.BooksGenres}" Grid.Row="1" Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="White">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Genres.Name}"/>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel/>
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                            </ListBox>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Background="DodgerBlue" Margin="5" Click="ReadingClick">
                                                <Image Source="/Images/Icons/book.png" Width="20"/>
                                            </Button>
                                            <Button Background="Coral" Margin="5" Click="LaterClick">
                                                <Image Source="/Images/Icons/clock.png" Width="20"/>
                                            </Button>
                                            <Button Background="ForestGreen" Margin="5" Click="FinishedClick">
                                                <Image Source="/Images/Icons/Check.png" Width="20"/>
                                            </Button>
                                            <Button Background="Gray" Margin="5" Click="AbandonedClick">
                                                <Image Source="/Images/Icons/trash.png" Width="20"/>
                                            </Button>
                                        </StackPanel>
                                        <Button Background="#131326" Foreground="White" Width="100" Margin="5" Click="Button_Click">Читать</Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
