<Page x:Class="LibraryApp.Pages.EditBookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LibraryApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditBookPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.ColumnSpan="3">
            <DockPanel Margin="5">
                <TextBlock VerticalAlignment="Center">Название:</TextBlock>
                <TextBox x:Name="Name" Text="{Binding Name}" FontSize="24" Margin="10" HorizontalAlignment="Stretch"></TextBox>
            </DockPanel>
            <DockPanel Margin="5">
                <TextBlock VerticalAlignment="Center">Описание:</TextBlock>
                <TextBox x:Name="Desc" Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" Grid.Column="0" Margin="10" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.CanContentScroll="True"></TextBox>
            </DockPanel>
        </StackPanel>
        <DockPanel Margin="5" Grid.Row="1" Grid.ColumnSpan="3">
            <TextBlock VerticalAlignment="Center">Текст:</TextBlock>
            <TextBox x:Name="text" Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" Grid.Column="0" Margin="10" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.CanContentScroll="True"></TextBox>
        </DockPanel>

        <ListBox x:Name="AllGenresList" Grid.Row="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}"></TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Center">
            <Button x:Name="AddGenre" Width="40" Height="40" Content="+" FontSize="22" Margin="5" Foreground="White" Background="ForestGreen" Click="AddGenre_Click"></Button>
            <Button x:Name="RemoveGenre" Width="40" Height="40" Content="-" FontSize="22" Margin="5" Foreground="White" Background="Red" Click="RemoveGenre_Click"></Button>
        </StackPanel>

        <ListBox x:Name="ChosenGenresList" Grid.Row="2" Grid.Column="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}"></TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <Button Grid.Row="3" Background="#131326" Foreground="White" Width="110" Margin="5" FontSize="20" Click="Button_Click" Grid.ColumnSpan="3">Сохранить</Button>
    </Grid>
</Page>
