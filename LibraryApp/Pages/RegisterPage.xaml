<Page x:Class="LibraryApp.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LibraryApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegisterPage">

    <Grid>
        <StackPanel Grid.Row="1" Margin="0 30" Width="400">
            <TextBlock FontSize="18" FontWeight="Bold" Text="Sign up" HorizontalAlignment="Center"/>
            <StackPanel Margin="0 10" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock FontSize="18" Text="Username: " HorizontalAlignment="Center"/>
                <TextBox x:Name="LoginBox" Width="200"></TextBox>
            </StackPanel>
            <StackPanel Margin="0 10" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock FontSize="18" Text="Password: " HorizontalAlignment="Center"/>
                <PasswordBox x:Name="PassBox1" Width="200"></PasswordBox>
            </StackPanel>
            <TextBlock FontSize="10" Text="Password MUST be at least 8 characters long, inlcude numbers and letters" HorizontalAlignment="Center"/>
            <StackPanel Margin="0 10" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock FontSize="18" Text="Confirm Password: " HorizontalAlignment="Center"/>
                <PasswordBox x:Name="PassBox2" Width="200"></PasswordBox>
            </StackPanel>
            <StackPanel Margin="0 10" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock FontSize="18" Text="Name: " HorizontalAlignment="Center"/>
                <TextBox x:Name="NameBox" Width="200"></TextBox>
            </StackPanel>
            <StackPanel Margin="0 10" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock FontSize="18" Text="Email: " HorizontalAlignment="Center"/>
                <TextBox x:Name="EmailBox" Width="200"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock FontSize="12" Text="Already have an account?" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Margin="5 10" Background="#131326" Foreground="White" Click="LogInButton_Click">Log in!</Button>
            </StackPanel>
            <Button x:Name="SignupButton" Margin="0 10" Width="100" Background="#131326" Foreground="White" Click="SignupButton_Click">Sign up</Button>
        </StackPanel>
    </Grid>
</Page>
