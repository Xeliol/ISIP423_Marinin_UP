<Page x:Class="LibraryApp.Pages.AuthorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LibraryApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthorPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ListBox x:Name="BooksListBox" Grid.Column="0" BorderThickness="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="White">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Height="450" Width="250">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Background" Value="White" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Frozen}" Value="True">
                                        <Setter Property="Background" Value="LightBlue" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Image Source="{Binding ImagePath}" Margin="10"/>
                        <TextBlock FontSize="18" Text="{Binding Name}"/>
                        <TextBlock Text="{Binding Users.Name, StringFormat={}Автор: {0}}"/>
                        <TextBlock Text="{Binding Rating, StringFormat={}Рейтинг: {0}}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Жанры:"/>
                            <ListBox ItemsSource="{Binding BooksGenres}" Grid.Row="1" Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="White">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Genres.Name}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </StackPanel>
                        <Button Background="#131326" Foreground="White" Width="100" Margin="5" Click="Button_Click">Читать</Button>
                        <Button Background="Orange" Foreground="Black" Width="150" Margin="5" Click="Edit_Click">Редактировать</Button>
                        <Button Background="Blue" Foreground="White" Width="120" Margin="5" Click="RequestUnfreeze_Click" Content="Оспорить заморозку">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Frozen}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Background="Red" Foreground="White" Width="130" Margin="5" Click="Delete_Click">Удалить</Button>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        
        <StackPanel Grid.Column="2" Margin="0 50">
            <Button x:Name="RequestUnfreeze" Background="ForestGreen" Foreground="White" Width="160" Margin="5" FontSize="20" Click="Create_Click" Content="Добавить книгу"></Button>
        </StackPanel>
    </Grid>
</Page>
